{
    "display_information": {
        "name": "Magento notifications",
        "description": "Posts your shop's notifications to Slack."
    },
    "features": {
        "bot_user": {
            "display_name": "Magento",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "chat:write.public"
            ]
        }
    },
    "settings": {
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}
